% NeurIPS 2026 style (simplified, tectonic/XeTeX compatible)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/01/01 NeurIPS 2026 Style]

% Options
\newif\if@preprint\@preprintfalse
\DeclareOption{preprint}{\@preprinttrue}
\DeclareOption{final}{\@preprintfalse}
\ProcessOptions\relax

% Page layout
\RequirePackage[letterpaper,
  textwidth=5.5in,
  textheight=9in,
  marginparwidth=0.7in,
  top=1in,
  left=1.5in]{geometry}

% Math
\RequirePackage{amsmath,amssymb,amsfonts}

% Line spacing
\renewcommand{\baselinestretch}{1.0}

% Section formatting
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

% Title formatting
\renewcommand{\maketitle}{%
  \begin{center}%
    {\LARGE\bfseries \@title \par}%
    \vskip 0.5em%
    {\large \@author \par}%
    \vskip 1em%
  \end{center}%
}

% Abstract
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}\small%
}{%
  \end{quote}%
}

% References
\RequirePackage{natbib}
\bibliographystyle{abbrvnat}
\setcitestyle{authoryear,round}

% Hyperlinks (load last)
\RequirePackage[colorlinks=true,citecolor=blue,urlcolor=blue,linkcolor=black]{hyperref}

\endinput
