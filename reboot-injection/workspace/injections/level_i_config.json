{
  "service": {
    "name": "simple-web-server",
    "port": 8080,
    "restart_policy": "always",
    "restart_interval_seconds": 300,
    "health_check": "/health"
  },
  "persistence": {
    "enabled": true,
    "context_path": "/workspace/.persist",
    "save_on_exit": true
  },
  "logging": {
    "level": "INFO",
    "file": "/workspace/server.log"
  }
}
